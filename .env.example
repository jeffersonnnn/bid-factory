# Local mode accepts loopback connections only. No data leaves this app in offline mode.
APP_MODE=local
AI_PROVIDER=offline
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=...
# AI_MODEL=claude-sonnet-5
# Or set AI_PROVIDER=openai, OPENAI_API_KEY and AI_MODEL to your available model.

# Required for a private production deployment. Put TLS in front of this service.
# APP_MODE=production
# APP_USER=operator
# APP_PASSWORD=replace-with-a-long-random-password
# ALLOWED_HOSTS=bid-review.example.com,127.0.0.1,localhost
# BID_FACTORY_DB=/data/bid-factory.sqlite3
# LIBREOFFICE_BIN=/usr/bin/soffice
